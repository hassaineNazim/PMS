# ---- docker-compose environment ----
# Copy to .env and adjust for your deployment.

# PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=pms

# API
ASPNETCORE_ENVIRONMENT=Production
# IMPORTANT: change this to a long random secret in production (>= 32 chars).
JWT_SECRET=CHANGE_ME_super_secret_key_at_least_32_chars_long!!

# In-room display / IPTV provider: "none" or "lg" (LG Pro:Centric / SuperSign)
DISPLAY_PROVIDER=none
DISPLAY_BASEURL=http://procentric-middleware:8080/procentric/api
